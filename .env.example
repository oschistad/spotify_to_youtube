SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Google Cloud OAuth client used for YouTube Music (subscribe step).
# Create an "OAuth client ID" of type "TV and Limited Input devices".
YT_OAUTH_CLIENT_ID=your_google_oauth_client_id
YT_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Only needed if your YT Music account is a brand account (separate channel
# identity on top of your Google account). Get it from
# https://myaccount.google.com/brandaccounts -> URL has /b/<user_id>/
YT_BRAND_ACCOUNT_ID=
